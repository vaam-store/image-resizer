# Local environment overrides for `emgr`. Copy this file to `.env` and
# adjust as needed - `.env` itself is gitignored (GH #48; it used to be
# committed, holding MinIO's public demo credentials).
#
# This mirrors the real environment surface in src/modules/env/env.rs.
# `.github/workflows/ci.yml`'s `docs-env-drift` job fails the build if
# docs/getting-started/configuration.md drifts from that file - keep this
# file and that doc in sync with it too when adding a new variable.

# --- Storage backend selection ---
# One of: LOCAL_FS (aliases: LOCALFS, LOCAL), S3 (alias: MINIO),
# IN_MEMORY (aliases: INMEMORY, MEMORY - test/dev only, refuses to start
# in a release build). Only takes effect for whichever storage feature(s)
# the binary was compiled with (`--features local_fs`, `--features s3`).
STORAGE_TYPE="LOCAL_FS"

# --- Local filesystem storage (feature = "local_fs") ---
LOCAL_FS_STORAGE_PATH="./data/images"

# --- MinIO / S3 storage (feature = "s3") ---
# MINIO_ENDPOINT_URL="http://localhost:9000"
# MINIO_ACCESS_KEY_ID="minioadmin"
# MINIO_SECRET_ACCESS_KEY="minioadmin"
# MINIO_BUCKET="image-cache"
# MINIO_REGION="us-east-1"

# Prefix prepended to every generated cache key, for both backends above.
# STORAGE_SUB_PATH=""

# --- General ---
# Base URL used to build the redirect Location header on a successful
# resize (see the README's status-code note: this is a 301, not a 302).
CDN_BASE_URL="http://localhost:3000/api/images/files"

# HOST="0.0.0.0"
# PORT="3000"

# --- SSRF / source-fetch guard (GH #21) ---
# MAX_REDIRECTS="5"
# ALLOWED_SOURCES=""
# ALLOW_LOOPBACK_SOURCE_ADDRESSES="false"
# ALLOW_LINK_LOCAL_SOURCE_ADDRESSES="false"

# --- Resolution / output limits (GH #26) ---
# MAX_SRC_RESOLUTION_MP="50"
# MAX_OUTPUT_WIDTH="4096"
# MAX_OUTPUT_HEIGHT="4096"

# --- Performance tuning ---
# See docs/getting-started/configuration.md for the full list and the
# PERFORMANCE_PROFILE presets (high_throughput / low_latency /
# memory_efficient) these override.
# PERFORMANCE_PROFILE="high_throughput"
# MAX_CONCURRENT_DOWNLOADS="20"
# MAX_CONCURRENT_PROCESSING="4"
# HTTP_TIMEOUT_SECS="30"
# MAX_IMAGE_SIZE_MB="50"
# CPU_THREAD_POOL_SIZE=""
# ENABLE_HTTP2="true"
# CONNECTION_POOL_SIZE="50"
# KEEP_ALIVE_TIMEOUT_SECS="60"

# --- Observability (feature = "otel") ---
# LOG_LEVEL="debug"
# OTLP_SPAN_ENDPOINT="http://localhost:4317"
# OTLP_METRIC_ENDPOINT="http://localhost:4318/v1/metrics"
# OTLP_SERVICE_NAME="rust-app-example"
